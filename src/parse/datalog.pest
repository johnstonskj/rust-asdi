// ------------------------------------------------------------------------------------------------
// Top-Level definitions
// ------------------------------------------------------------------------------------------------

program = {
    SOI ~ pragma* ~ ( fact | rule | query )* ~ EOI
}

// ------------------------------------------------------------------------------------------------
// Intermediate definitions
// ------------------------------------------------------------------------------------------------

// Per the datalog spec § Relations & Facts:
//   fact       ::= assertion | retraction ;
//   assertion  ::= fact-body "." ;
//   retraction ::= fact-body "~" ;
// We model that as a single `fact` production with a non-silent
// `fact_terminator` so the parser can tell `.` (assert) from `~`
// (retract) by inspecting the matched text.
fact = {
    predicate ~ (LEFT_PAREN ~ constant_list ~ RIGHT_PAREN)? ~ fact_terminator
}

fact_terminator = {
    DOT | TILDE
}

rule = {
    rule_head? ~ material_implication ~ rule_body ~ DOT
}

rule_head = {
    // FEATURE: constraints
    UC_FALSUM
             // FEATURE: disjunction
    | atom ~ ( disjunction ~ atom )*
}

rule_body = {
    literal_list
}


query = {
    ( query_prefix ~ atom ~ DOT )
    | ( atom ~ QMARK )
}

atom = {
    predicate ~ ( LEFT_PAREN ~ term_list ~ RIGHT_PAREN )
}

literal = {
    // FEATURE: negation
    // FEATURE: comparisons
    negation? ~ ( atom | comparison )
}

literal_list = _{
    literal ~ ( conjunction ~ literal )*
}

comparison = {
    named_term ~ comparison_operator ~ named_term ?
}

term = {
    variable | constant
}


named_term = {
    named_variable | constant
}

term_list = _{
    term ~ ( COMMA ~ term )*
}

constant = {
    boolean | unquoted_string | quoted_string | number
}

constant_list = _{
    constant ~ ( COMMA ~ constant)*
}

predicate = @{
    LOWERCASE_LETTER ~ ( CASED_LETTER | DECIMAL_NUMBER | UNDERSCORE )*
}

variable = _{
    anonymous_variable | named_variable
}

anonymous_variable = {
    UNDERSCORE
}

named_variable = @{
    UPPERCASE_LETTER ~ ( CASED_LETTER | DECIMAL_NUMBER | UNDERSCORE )*
}

identifier_relaxed = @{
    LETTER ~ ( CASED_LETTER | DECIMAL_NUMBER | UNDERSCORE )*
}

subscript = @ {
    ASCII_DIGIT+
}

// ------------------------------------------------------------------------------------------------
// Pragmas
// ------------------------------------------------------------------------------------------------

pragma = {
    DOT ~ (pragma_assert | pragma_fd | pragma_infer | pragma_feature | pragma_input | pragma_output | pragma_pragma) ~ DOT
}

// Per the datalog spec § Pragmas:
//   pi-pragma ::= "pragma" predicate ( "=" constant )? ;
// The universal pragma form. Known names map to feature flags
// (`negation`, `comparisons`, …) or program-level settings (`strict`,
// `base`, `results`, `extended_numerics`); unknown names trigger a
// `tracing::warn!` in lax mode (the default) and would be an error
// once `strict` mode is honored.
pragma_pragma = {
    keyword_pragma ~ predicate ~ ( EQUALS ~ constant )?
}

pragma_assert = {
    keyword_assert ~ predicate ~ attribute_declaration_list
}

pragma_fd = {
    keyword_fd ~ predicate ~ COLON ~ attribute_index_list ~ depends_on ~ attribute_index_list
}

attribute_index_list = _{
    attribute_index ~ ( COMMA ~ attribute_index )*
}

attribute_index = _{
    subscript | predicate
}

pragma_infer = {
    keyword_infer ~ predicate ~ ( attribute_declaration_list | ( "from" ~ predicate ))
}

attribute_declaration_list = _{
    LEFT_PAREN ~ attribute_declaration ~ (COMMA ~ attribute_declaration)* ~ RIGHT_PAREN
}

attribute_declaration = {
    ( predicate ~ ":" )? ~ ( type_id_string | type_id_integer | type_id_boolean )
}

pragma_feature = {
    keyword_feature ~ LEFT_PAREN ~ feature_list ~ RIGHT_PAREN
}

feature_list = _{
    feature_id ~ ( COMMA ~ feature_id )*
}

feature_id = _{
    feature_id_negation
    | feature_id_comparisons
    | feature_id_constraints
    | feature_id_disjunction
    | feature_id_functional_dependencies
}

// Per spec § Processing Instructions:
//   pi-input              ::= "input" io-details ;
//   io-details            ::= predicate parameter-list ;
//   parameter-list        ::= "(" parameter-assignment ( "," parameter-assignment )* ")" ;
//   parameter-assignment  ::= predicate "=" constant ;
//
// Example (spec-conformant):
//   .input(human, uri="data/humans.csv", type="text/csv", header=present).
//
// The legacy positional form is kept for back-compat:
//   .input(human, "data/humans.csv", "csv").
//
// The two forms are distinguished by pest's alternation: the new form
// starts with `predicate ~ EQUALS`, the legacy form with
// `quoted_string`. Order matters — `io_parameter_list` must come
// first so a `predicate` token isn't accidentally consumed as a
// bareword by the positional path's (non-existent) bareword arm.
pragma_input = {
    keyword_input ~ LEFT_PAREN ~ predicate ~ COMMA
        ~ ( io_parameter_list | io_positional ) ~ RIGHT_PAREN
}

pragma_output = {
    keyword_output ~ LEFT_PAREN ~ predicate ~ COMMA
        ~ ( io_parameter_list | io_positional ) ~ RIGHT_PAREN
}

io_parameter_list = {
    parameter_assignment ~ ( COMMA ~ parameter_assignment )*
}

parameter_assignment = {
    predicate ~ EQUALS ~ constant
}

io_positional = {
    quoted_string ~ ( COMMA ~ quoted_string )?
}

keyword_assert = _{
    "assert"
}

keyword_infer = _{
    "infer"
}

keyword_fd = _{
    "fd"
}

keyword_feature = _{
    "feature"
}

keyword_pragma = _{
    "pragma"
}

keyword_include = _{
    "include"
}

keyword_input = _{
    "input"
}

keyword_output = _{
    "output"
}

type_id_string = {
    "string"
}

type_id_integer = {
    "integer"
}

type_id_boolean = {
    "boolean"
}

feature_id_negation = {
    "negation"
}

feature_id_comparisons = {
    "comparisons"
}

feature_id_constraints = {
    "constraints"
}

feature_id_disjunction = {
    "disjunction"
}

feature_id_functional_dependencies = {
    "functional_dependencies"
}

// ------------------------------------------------------------------------------------------------
// Constant definitions
// ------------------------------------------------------------------------------------------------

quoted_string = _{
    QUOTE ~ string ~ QUOTE
}

unquoted_string = @{
    predicate ~ ( COLON ~ identifier_relaxed )?
}

string = @{
    string_char*
}

// Per the datalog spec § Strings:
//   string-escape ::= "\\" ( DQUOTE | [tnr] )
//                  | "\u{" HEXDIGIT{4} ( HEXDIGIT{4} )? "}" ;
// i.e. one-character escapes are `\"`, `\t`, `\n`, `\r`; Unicode escapes
// are `\u{XXXX}` (4 hex) or `\u{XXXXXXXX}` (exactly 8 hex). We also
// permit `\\` (universally-assumed self-escape; arguably a spec bug).
//
// Note: in a pest ordered choice, the longer `{8}` alternative MUST come
// before `{4}`, otherwise the parser commits to a 4-digit match and
// leaves the remaining hex chars as literal characters in the string.
string_char = {
    !( "\"" | "\\" ) ~ ANY
    | "\\" ~ ( "\"" | "\\" | "t" | "n" | "r" )
    | "\\" ~ "u" ~ LEFT_BRACE ~ ( ASCII_HEX_DIGIT{8} | ASCII_HEX_DIGIT{4} ) ~ RIGHT_BRACE
}

// Per spec § Numbers:
//   - `integer` (always supported, ≥64-bit signed).
//   - `float` (requires `extended_numerics`) — supports plain decimal
//     notation (`3.14`), scientific notation (`1.5e3`), and the R7RS
//     IEEE-special literals `+inf.0`, `-inf.0`, `+nan.0`.
//   - `decimal` (requires `extended_numerics`, 128-bit fixed-point) is
//     spec-mandated but not yet implemented at the constant level —
//     plain-decimal literals currently flow through `Number::Float`.
//
// Alternative order matters: `float_special` and `float` must come
// before `integer`, because `+1.5` would otherwise greedy-match `+1`
// as integer and leave `.5` dangling.
number = _{
    float_special | float | integer
}

float_special = @{
    ( "+" | "-" ) ~ "inf.0"
}

// Note: `+nan.0` is intentionally NOT included here. The current
// `Constant::Number(Number)` wraps a `NotNan<f64>`, so a NaN literal
// would fail at constant construction. Adding `+nan.0` requires
// migrating to `OrderedFloat<f64>` and auditing the codepaths that
// rely on `from_f64(...).is_some()` meaning "finite". Tracked in
// IMPROVEMENTS.md §1.4 item 5.

float = @{
    decimal ~ ( ("e" | "E") ~ integer )?
}

decimal = @{
    integer ~ DOT ~ ASCII_DIGIT+
}

rational = @{
    integer ~ "/" ~ rational
}

integer = @{
    ( "+" | "-" )? ~ ASCII_DIGIT+
}

boolean = {
    boolean_true | boolean_false
}

boolean_true = _{
	"true"
}

boolean_false = _{
	"false"
}

// ------------------------------------------------------------------------------------------------
// Terminal definitions
// ------------------------------------------------------------------------------------------------

depends_on = {
    "-->" | "⟶"
}

// LONG RIGHTWARDS ARROW
// Unicode: U+27F6, UTF-8: E2 9F B6

material_implication = _{
    ":-" | "<-" | UC_LEFT_ARROW_FW
}

negation = {
    EXCLAMATION | UC_LOGICAL_NOT_FW | "NOT"
}

conjunction = _{
    COMMA | UC_LOGICAL_AND | AMPERSAND | "AND"
}

disjunction = _{
    inclusive_disjunction
}

inclusive_disjunction = _{
    SEMI_COLON | UC_LOGICAL_OR | VERTICAL_BAR | "OR"
}

// ----- For future use -----
// exclusive_disjunction = _{
//     UC_LOGICAL_XOR | "XOR"
// }

query_prefix = _{
    "?-"
}

comparison_operator = {
    LESS_THAN | less_or_equal | GREATER_THAN | greater_or_equal | EQUALS | not_equal | string_match
}

less_or_equal = _{
    "<=" | UC_LTE
}

greater_or_equal = _{
    ">=" | UC_GTE
}

not_equal = _{
    "!=" | "/=" | UC_NOT_EQUAL
}

string_match = _{
    "*=" | UC_STAR_EQUAL | "MATCHES"
}

UC_LOGICAL_AND = _{ "∧" }

UC_LOGICAL_OR = _{ "∨" }

UC_LOGICAL_XOR = _{ "⊕" }

UC_LOGICAL_NOT_FW = _{ "￢" }

UC_LEFT_ARROW_FW = _{ "⟵" }

UC_TRUTH = _{ "⊤" }

UC_FALSUM = _{ "⊥" }

UC_LTE = _{ "≤" }

UC_GTE = _{ "≥" }

UC_NOT_EQUAL = _{ "≠" }

UC_STAR_EQUAL = _{ "≛" }

LEFT_PAREN = _{ "(" }

RIGHT_PAREN = _{ ")" }

LEFT_BRACE = _{ "{" }

RIGHT_BRACE = _{ "}" }

LESS_THAN = _{
    "<"
}

GREATER_THAN = _{ ">" }

EQUALS = _{ "=" }

QUOTE = _{ "\"" }

HYPHEN_MINUS = _{ "-" }

UNDERSCORE = _{ "_" }

AMPERSAND = _{ "&" }

VERTICAL_BAR = _{ "|" }

EXCLAMATION = _{ "!" }

DOT = _{ "." }

TILDE = _{ "~" }

COMMA = _{ "," }

QMARK = _{ "?" }

COLON = _{ ":" }

SEMI_COLON = _{ ";" }

// ------------------------------------------------------------------------------------------------
// Built-in rules
// ------------------------------------------------------------------------------------------------

COMMENT = _{ block_comment | line_comment }

line_comment = _{ "%" ~ ( !NEWLINE ~ ANY )* }

block_comment = { "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

WHITESPACE = _{ " " | "\t" | NEWLINE }